<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CamCast" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/camcast_primary</item>
        <item name="colorOnPrimary">@color/camcast_on_primary</item>
    </style>

    <style name="Widget.CamCast.ToggleButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/toggle_button_background</item>
        <item name="android:textColor">@color/toggle_button_text</item>
        <!-- Long labels ("Posteriore") at large font sizes wrap instead of being cut. -->
        <item name="android:maxLines">2</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
    </style>
</resources>
