<?xml version="1.0" encoding="utf-8"?>
<!-- Keeps the chosen option visible while the form is locked (streaming); the stock style drops it when disabled. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="0.6" android:color="?attr/colorSecondaryContainer" android:state_checked="true" android:state_enabled="false" />
    <item android:color="?attr/colorSecondaryContainer" android:state_checked="true" />
    <item android:color="@android:color/transparent" />
</selector>
